<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de backup para Android >= 12 (dataExtractionRules). Excluimos la
     sesión de socia tanto del backup en la nube como de la transferencia. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="barrioteca_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="barrioteca_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
